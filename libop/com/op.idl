	[id(355)] HRESULT GetRandomNumber([in] LONG min, [in] LONG max, [out, retval] LONG* ret);
	[id(356)] HRESULT GetRandomDouble([in] DOUBLE min, [in] DOUBLE max, [out, retval] DOUBLE* ret);
	[id(357)] HRESULT GaiLu([in] LONG p, [out, retval] LONG* ret);
	[id(358)] HRESULT GetMachineCode([out, retval] BSTR* ret);
	[id(359)] HRESULT IsElevated([out, retval] LONG* ret);
	// Binding tuning (added 2026-09-23, ids appended to preserve vtable order)
	[id(360)] HRESULT LockWindowPosition([in] hyper hwnd, [in] LONG enable, [out, retval] LONG* ret);
	[id(361)] HRESULT LockWindowSize([in] hyper hwnd, [in] LONG enable, [out, retval] LONG* ret);
	[id(362)] HRESULT DisableMinMax([in] hyper hwnd, [in] LONG enable, [out, retval] LONG* ret);
	[id(363)] HRESULT SetIme([in] hyper hwnd, [in] LONG enable, [out, retval] LONG* ret);
	[id(364)] HRESULT GetFPS([out, retval] LONG* ret);
	[id(423)] HRESULT IsDisplayDead([in] LONG x1, [in] LONG y1, [in] LONG x2, [in] LONG y2, [in] LONG check_times, [in] LONG interval_ms, [out, retval] LONG* ret);
	[id(365)] HRESULT DownCpu([in] LONG type, [in] LONG rate, [out, retval] LONG* ret);
	[id(366)] HRESULT ClearPicCache([out, retval] LONG* ret);
	[id(367)] HRESULT SetPicCacheMax([in] LONG max_count, [out, retval] LONG* ret);
	[id(368)] HRESULT SetAStarMap([in] BSTR bitmap_file, [in] LONG scale, [in] LONG offset_x, [in] LONG offset_y, [out, retval] LONG* ret);
	[id(478)] HRESULT SetAStarMapData([in] LONG width, [in] LONG height, [in] SAFEARRAY(BYTE) data, [in] LONG scale, [in] LONG offset_x, [in] LONG offset_y, [out, retval] LONG* ret);
	[id(369)] HRESULT AStarFindPathBM([in] LONG beginX, [in] LONG beginY, [in] LONG endX, [in] LONG endY, [out, retval] BSTR* path);
	[id(370)] HRESULT AStarFindPathWay([in] BSTR points, [out, retval] BSTR* path);
	[id(371)] HRESULT SmoothPathByLOS([in] BSTR path, [out, retval] BSTR* retstr);
	[id(372)] HRESULT SimplifyPath([in] BSTR path, [in] DOUBLE epsilon, [out, retval] BSTR* retstr);
	[id(373)] HRESULT IsLineBlocked([in] LONG x1, [in] LONG y1, [in] LONG x2, [in] LONG y2, [out, retval] LONG* ret);
	[id(374)] HRESULT FindNearestPathPoint([in] BSTR path, [in] LONG x, [in] LONG y, [in, out] VARIANT* index, [in, out] VARIANT* nx, [in, out] VARIANT* ny, [out, retval] LONG* ret);
	[id(375)] HRESULT PointInPolygon([in] BSTR point, [in] BSTR polygon, [out, retval] LONG* ret);
	// 多角度模板匹配：angles 形如 "0|15|-15"（空串走默认角度集）；retjson 额外带命中角度 angle。
	[id(376)] HRESULT CvMatchTemplateRot([in] LONG x, [in] LONG y, [in] LONG width, [in] LONG height, [in] BSTR template_name, [in] BSTR angles, [in] DOUBLE threshold, [in] LONG method, [in] LONG color_mode, [out] BSTR* retjson, [out, retval] LONG* ret);
	// JSON 族（P3 第一批 2026-10-16）：无句柄路径直取式，路径 "a.b[0].c"（兼容 "a.b.0"）。
	// 失败约定：取值类空串/0，写类返回空串。
	[id(426)] HRESULT JsonIsValid([in] BSTR json_text, [out, retval] LONG* ret);
	[id(427)] HRESULT JsonGetString([in] BSTR json_text, [in] BSTR path, [out, retval] BSTR* retstr);
	[id(428)] HRESULT JsonGetNumber([in] BSTR json_text, [in] BSTR path, [out] DOUBLE* value, [out, retval] LONG* ret);
	[id(429)] HRESULT JsonGetBool([in] BSTR json_text, [in] BSTR path, [out] LONG* value, [out, retval] LONG* ret);
	[id(430)] HRESULT JsonGetSize([in] BSTR json_text, [in] BSTR path, [out, retval] LONG* ret);
	[id(431)] HRESULT JsonGetKeys([in] BSTR json_text, [in] BSTR path, [out, retval] BSTR* retstr);
	[id(432)] HRESULT JsonSetString([in] BSTR json_text, [in] BSTR path, [in] BSTR value, [out, retval] BSTR* retstr);
	[id(433)] HRESULT JsonSetNumber([in] BSTR json_text, [in] BSTR path, [in] DOUBLE value, [out, retval] BSTR* retstr);
	[id(434)] HRESULT JsonSetBool([in] BSTR json_text, [in] BSTR path, [in] LONG value, [out, retval] BSTR* retstr);
	[id(435)] HRESULT JsonAppend([in] BSTR json_text, [in] BSTR path, [in] BSTR raw_json, [out, retval] BSTR* retstr);
	[id(436)] HRESULT JsonDelete([in] BSTR json_text, [in] BSTR path, [out, retval] BSTR* retstr);
	// HTTP 小族（P3 第二项 2026-10-16，WinHTTP 系统直连）：对接大模型 API。
	// headers_json 为 JSON 对象文本；非 2xx 也返回响应体；传输失败空串。
	[id(437)] HRESULT HttpGet([in] BSTR url, [in] BSTR headers_json, [in] LONG timeout_ms, [out, retval] BSTR* retstr);
	[id(438)] HRESULT HttpPost([in] BSTR url, [in] BSTR body, [in] BSTR headers_json, [in] LONG timeout_ms, [out, retval] BSTR* retstr);
	[id(439)] HRESULT HttpDownloadFile([in] BSTR url, [in] BSTR file_name, [in] LONG timeout_ms, [out, retval] LONG* ret);

	// ---- P0 结构化 OCR（2026-11-20）：逐字置信度 + 逐字坐标，JSON 输出 ----
	// JSON 数组，每行 {"text","conf","is_partial",["conf_partial",]"box":[x1,y1,x2,y2],
	//   "partial_chars","chars":[{"ch","conf","x1","x2"}]}；坐标为原图像素坐标。
	// ⚠ conf（整行）与 chars[].conf（逐字）口径不同、不可互推。
	// ⚠ partial_chars=true：该行经倾斜旋转校正，逐字 x 退化为整行框范围。
	// 语义对齐 C API 的 OpOcrEx2 / OpOcrAutoColorEx2（DISPID 440 / 441）。
	// ⚠ OcrAutoColorEx2 的颜色为 **RGB 顺序** RRGGBB-DDDDDD（红色写 e01111），多色用 | 取并集；
	//   且内置智能选路：图中命中该色像素 <0.1% 时自动回退原图直识。
	[id(440)] HRESULT OcrEx2([in] LONG x1, [in] LONG y1, [in] LONG x2, [in] LONG y2, [in] BSTR color, [in] DOUBLE sim, [out] BSTR* retstr);
	[id(441)] HRESULT OcrAutoColorEx2([in] LONG x1, [in] LONG y1, [in] LONG x2, [in] LONG y2, [in] BSTR color, [in] DOUBLE sim, [out] BSTR* retstr, [out, retval] LONG* ret);

	// ---- P1 FindStr 增强（2026-11-21）：多目标结构化查找 + 字符级精确范围 ----
	// FindStrBatch：json_targets 为 JSON 数组，元素可为主字符串或配置对象
	//   {"id","text","match":"contains|exact|prefix|suffix|regex","fuzzy","max_hits","ci","confirmed_only"}；
	//   一次 det+rec 后在引擎内匹配全部目标，返回每目标的全部命中。
	// FindStrEx2：单目标标量入参（易语言友好）。flags 位：
	//   1=regex 2=exact 4=ci 64=fuzzy<=1 128=fuzzy<=2 256=confirmed_only（位 8/16/32 预留）。
	//   位 1/2/64/128 互斥，同时给多个 -> @ret 返回 -1 且 retstr 为空。
	// 两者返回的 JSON 同构，见 include/op_c_api.h 的 OpFindStrBatch 注释。
	// ⚠ cx1/cx2 为命中片段的字符级水平范围（P0 逐字坐标）；旋转降级或已装载字库时
	//   退化为整行范围，此时 char_precise=false。匹配不跨行。
	[id(442)] HRESULT FindStrBatch([in] LONG x1, [in] LONG y1, [in] LONG x2, [in] LONG y2, [in] BSTR json_targets, [in] BSTR color, [in] DOUBLE sim, [out] BSTR* retstr, [out, retval] LONG* ret);
	[id(443)] HRESULT FindStrEx2([in] LONG x1, [in] LONG y1, [in] LONG x2, [in] LONG y2, [in] BSTR pattern, [in] BSTR color, [in] DOUBLE sim, [in] LONG flags, [out] BSTR* retstr, [out, retval] LONG* ret);

	// ---- P3 OCR 分项耗时自省（2026-11-21） ----
	// 返回上次 OCR 的 {"valid","total_ms","pre_ms","det_ms","cls_ms","rec_ms","post_ms",
	//   "boxes","lines","chars","det_calls","rec_calls","cls_calls","runs_failed",
	//   "upscale","oscale","rec_width"}。不触发新的 OCR。
	[id(444)] HRESULT OcrLastProfile([out, retval] BSTR* retstr);
	// ---- 图像句柄注册表（P4 2026-11-21，内存直操作一期地基）----
	// 句柄为字符串 "img:<n>"，与 pic:<路径> 风格一致。设计见
	// docs/2026-11/内存模块优化_图像句柄注册表_方案_20261121.md。
	// 约定：注册后像素不可变；上限 256 条，满则拒绝新增（不淘汰既有句柄）；
	//       非法输入返回空串/0，不抛异常。
	// LoadImageMem 的 data 传像素缓冲区首地址（易语言用取变量地址）。
	[id(445)] HRESULT LoadImageMem([in] LONG_PTR data, [in] LONG width, [in] LONG height, [in] LONG stride, [in] BSTR fmt, [out, retval] BSTR* retstr);
	[id(446)] HRESULT LoadImageBmp([in] LONG_PTR data, [in] LONG size, [out, retval] BSTR* retstr);
	[id(447)] HRESULT FreeImage([in] BSTR image_handle, [out, retval] LONG* ret);
	[id(448)] HRESULT FreeAllImages([out, retval] LONG* ret);
	[id(449)] HRESULT GetImageSize([in] BSTR image_handle, [in, out] LONG* width, [in, out] LONG* height, [in, out] LONG* channels, [out, retval] LONG* ret);
	[id(450)] HRESULT GetImageData([in] BSTR image_handle, [in] BSTR fmt, [in] LONG_PTR buffer, [in] LONG buffer_size, [out, retval] LONG* ret);
	[id(451)] HRESULT CropImage([in] BSTR image_handle, [in] LONG x, [in] LONG y, [in] LONG width, [in] LONG height, [out, retval] BSTR* retstr);
	[id(452)] HRESULT FindStrMem([in] BSTR image_handle, [in] BSTR json_targets, [in] DOUBLE sim, [out, retval] BSTR* retstr);
	[id(453)] HRESULT GetImageCount([out, retval] LONG* ret);




